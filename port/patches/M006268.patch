+theorem tprod_prod_smul {ι : Type*} [Fintype ι] {A : Type*} [CommRing A]
+    {M : ι → Type*} [∀ i, AddCommGroup (M i)] [∀ i, Module A (M i)]
+    (c : ι → A) (e : ∀ i, M i) :
+    (∏ i, c i) • PiTensorProduct.tprod A e
+      = PiTensorProduct.tprod A (fun i => c i • e i) := by
+  classical
+  have step : ∀ (F : ∀ i, M i) (a : ι) (d : A),
+      d • PiTensorProduct.tprod A F
+        = PiTensorProduct.tprod A (Function.update F a (d • F a)) := by
+    intro F a d
+    have h1 : PiTensorProduct.tprod A F = PiTensorProduct.tprodCoeff A 1 F := rfl
+    have h2 : PiTensorProduct.tprod A (Function.update F a (d • F a))
+        = PiTensorProduct.tprodCoeff A 1 (Function.update F a (d • F a)) := rfl
+    rw [h1, h2, PiTensorProduct.smul_tprodCoeff' d (1 : A) F,
+      PiTensorProduct.smul_tprodCoeff (1 : A) F a d]
+  have key : ∀ (s : Finset ι),
+      (∏ i ∈ s, c i) • PiTensorProduct.tprod A e
+        = PiTensorProduct.tprod A (s.piecewise (fun i => c i • e i) e) := by
+    intro s
+    induction s using Finset.induction with
+    | empty => simp
+    | @insert a s has ih =>
+      rw [Finset.prod_insert has, mul_smul, ih, Finset.piecewise_insert]
+      have haF : (s.piecewise (fun i => c i • e i) e) a = e a := by simp [has]
+      rw [← haF]
+      exact step _ _ _
+  simpa using key Finset.univ
 
